      "normalizerSettings": [
        {
          "normalizerId": "normalizeInputToAzureOpenAI",
          "includeAttributes": [
            {
              "attributeName": "messages",
              "attributeValue": {
                "role": "developer",
                "content": "Always respond in Markdown. Use bullet points for lists and keep answers concise."
              },
              "op": "insert",
              "index": 1
            },
            {
              "attributeName": "temperature",
              "attributeValue": 0.75
            }
          ],
          "replaceAttributes": [
            {
              "fromAttributeName": "max_completion_tokens",
              "toAttributeName": "max_tokens",
              "value": 500
            }
          ]
        },
        {
          "normalizerId": "normalizeOutputToOpenAI",
          "excludeAttributes": [
            {
              "attributeName": "prompt_filter_results"
            },
            {
              "attributeName": "choices[*].content_filter_results"
            },
            {
              "attributeName": "system_fingerprint"
            }
          ],
          "includeAttributes": [
            {
              "attributeName": "service_tier",
              "attributeValue": "azure"
            }
          ]
        }
      ],
      "endpoints": [
        {
          "id": "useast2-global-standard",
