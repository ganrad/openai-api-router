{
  "serverId": "Ai-App-Gateway-Local",
  "serverType": "single-domain",
  "applications": [
    {
      "appId": "ai-chatbot-gpt4o",
      "description": "An AI Assistant / Chatbot application which uses gpt-4o (Omni) mini model for answering GK questions.",
      "appType": "azure_oai",
      "cacheSettings": {
        "useCache": true,
        "searchType": "CosineSimilarity",
        "searchDistance": 0.92,
        "searchContent": {
          "term": "messages",
          "includeRoles": "user"
        },
        "entryExpiry": "2 minutes"
      },
      "memorySettings": {
        "useMemory": true,
        "msgCount": 4,
        "entryExpiry": "5 minutes"
      },
      "endpoints": [
        {
          "rpm": 10,
          "uri": "https://oai-gr-dev.openai.azure.com/openai/deployments/gpt-4o-mini/chat/completions?api-version=2024-10-21",
          "apikey": "9eca9ec12e1e4be4a38d00282f0d266d"
        }
      ]
    },
    {
      "appId": "vectorizedata",
      "description": "Application that uses OAI model to generate data embeddings/vectors",
      "appType": "azure_oai",
      "cacheSettings": {
        "useCache": false
      },
      "memorySettings": {
        "useMemory": false
      },
      "endpoints": [
        {
          "uri": "https://oai-gr-dev.openai.azure.com/openai/deployments/dev-embedd-ada-002/embeddings?api-version=2023-05-15",
          "apikey": "9eca9ec12e1e4be4a38d00282f0d266d"
        }
      ]
    }
  ]
}