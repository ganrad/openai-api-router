  "remoteServerConfig": [
    {
      "id": "supply-chain-fulfillment-mcp-server",
      "name": "Supply Chain Fulfillment",
      "description": "Exposes tools for supply chain fulfillment such as sales order management (order info & status), creating/revising shipment plans, checking shipment dates etc",
      "protocol": "MCP",
      "uri": "https://supply-chain-fulfill-mcp-server.whiteground-1e998745.westus2.azurecontainerapps.io/mcp",
      "tags": [
        "supply-chain-management",
        "fulfillment",
        "shipment-management",
        "order-management"
      ],
      "auth": {
        "authType": "ApiKey",
        "keyName": "x-api-key",
        "keyValue": "demo-api-key-12345"
      },
      "examples": [
        "Get me the status of sales order SO-10045",
        "Get me sales order info for SO-10045",
        "For order SO-10045, can we deliver to 98109 by July 12? If yes, pick the cheapest carrier that meets the date and create a shipment plan."
      ],
      "inputModes": [
        "text/plain"
      ],
      "outputModes": [
        "text/plain"
      ]
    },
