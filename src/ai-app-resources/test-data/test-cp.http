### Request to retrieve the AI Application Gateway operations
GET {{baseUrl}}/AiAppServer/operations
Authorization: Bearer {{BearerToken}}

### Request to retrieve the AI App Gateway configuration
GET {{baseUrl}}/AiAppServer/get
Authorization: Bearer {{BearerToken}}

### Request to deploy an AI App Gateway along with AI Apps
POST {{baseUrl}}/AiAppServer/deploy
Content-Type: {{contentType}}
Authorization: Bearer {{BearerToken}}

{
  "serverId": "Ai-App-Gateway-Local",
  "serverType": "single-domain",
  "applications": [
    {
      "appId": "ai-app-grok-3-mini",
      "description": "An AI Application that uses grok-3-mini model to generate content",
      "appType": "azure_oai",
      "searchAiApp": "",
      "cacheSettings": {
        "useCache": true,
        "searchType": "CosineSimilarity",
        "searchDistance": 90,
        "searchContent": {
          "term": "messages",
          "includeRoles": "user"
        },
        "entryExpiry": "10 minutes"
      },
      "memorySettings": {
        "affinity": true,
        "useMemory": true,
        "msgCount": 5,
        "entryExpiry": "10 minutes"
      },
      "personalizationSettings": {
        "userMemory": true,
        "generateFollowupMsgs": true,
        "userFactsAppName": "",
        "extractionPrompt": "",
        "followupPrompt": ""
      },
      "endpoints": [
        {
          "id": "useast2-global-standard",
          "rpm": 10,
          "uri": "https://ganes-mbjvew83-eastus2.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview",
          "apikey": "jaw3JUiwF"
        }
      ]
    }
  ],
  "budgetConfig": [
    {
      "budgetName": "AzureAIFoundry-OpenAI",
      "description": "A budget class for OpenAI models on Azure AI Foundry",
      "models": [
        {
          "modelName": "gpt-4.1-mini-global",
          "tokenPriceInfo": {
            "inputTokensCostPer1k": 0.0004,
            "cachedInputTokensCostPer1k": 0.0001,
            "outputTokensCostPer1k": 0.0016
          }
        }
      ]
    }
  ]
}

### Request to retrieve the AI Application operations
GET {{baseUrl}}/AiApplication/operations
Authorization: Bearer {{BearerToken}}

### Request to get an AI Application's details
GET {{baseUrl}}/AiApplication/ai-app-grok-30-mini/get
Authorization: Bearer {{BearerToken}}

