### Add/update AI Application
POST {{baseUrl}}/AiApplication/deploy
Content-Type: {{contentType}}
Authorization: Bearer {{BearerToken}}

{
  "appId": "ai-app-grok-30-mini",
  "description": "An AI Application that uses grok-3-mini model to generate content",
  "appType": "azure_aimodel_inf",
  "isActive": true,
  "searchAiApp": "",
  "cacheSettings": {
    "useCache": true,
    "searchType": "CosineSimilarity",
    "searchDistance": 0.90,
    "searchContent": {
      "term": "messages",
      "includeRoles": "user"
    },
    "entryExpiry": "10 minutes"
  },
  "memorySettings": {
    "affinity": true,
    "useMemory": true,
    "msgCount": 5,
    "entryExpiry": "10 minutes"
  },
  "personalizationSettings": {
    "userMemory": false
  },
  "endpoints": [
    {
      "id": "useast2-global-standard",
      "rpm": 10,
      "uri": "https://aif-project-westus3-072-resource.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview",
      "apikey": "FqUADqACfWD61m1GVyI6JVrTpWiLmLioWBO816HjAgWcRzqz3iQOJQQJ99BGACMsfrFXJ3w3AAAAACOG9h56"
    }
  ]
}

### Random test for grok-3-mini model
POST https://aif-project-westus3-072-resource.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview
Content-Type: {{contentType}}
Authorization: Bearer {{BrToken}}

{
  "messages": [
      {
          "role": "user",
          "content": "I am going to Paris, what should I see?"
      }
  ],
  "max_completion_tokens": 1000,
  "temperature": 1,
  "top_p": 1,
  "model": "grok-3-mini"
}