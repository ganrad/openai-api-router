{
  "appId": "garmin-ai-chatbot-gpt4o",
  "description": "An AI Assistant / Chatbot application which uses gpt-4o (Omni) model for Q&A on Garmin GPS support manuals",
  "appType": "azure_oai",
  "searchAiApp": "search-garmin-docs",
  "cacheSettings": {
    "useCache": true,
    "searchType": "CosineSimilarity",
    "searchDistance": 0.98,
    "searchContent": {
      "term": "messages",
      "includeRoles": "user"
    },
    "entryExpiry": "5 minutes"
  },
  "memorySettings": {
    "useMemory": true,
    "msgCount": 5,
    "entryExpiry": "5 minutes"
  },
  "endpoints": [
    {
      "rpm": 10,
      "uri": "https://oai-gr-dev.openai.azure.com/openai/deployments/dev-gpt-4o/chat/completions?api-version=2025-01-01-preview",
      "apikey": "9eca9ec12e1e4be4a38d00282f0d266d"
    }
  ]
}