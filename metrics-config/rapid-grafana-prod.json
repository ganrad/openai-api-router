{
  "title": "RAPID AI Gateway - Metrics Dashboard",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "ai_application",
        "type": "query",
        "label": "AI Application",
        "datasource": "Prometheus",
        "refresh": 1,
        "query": "label_values(rapid_ai_application_gateway_endpoint_api_calls, ai_application)",
        "multi": false,
        "includeAll": false
      },
      {
        "name": "endpoint_id",
        "type": "query",
        "label": "Endpoint",
        "datasource": "Prometheus",
        "refresh": 1,
        "query": "label_values(rapid_ai_application_gateway_endpoint_api_calls{ai_application=\"$ai_application\"}, endpoint_id)",
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "API calls breakdown by endpoint",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "rapid_ai_application_gateway_endpoint_api_calls{ai_application=\"$ai_application\",endpoint_id=~\"$endpoint_id\",outcome=\"success\"}",
          "legendFormat": "{{endpoint_id}} - success (200)"
        },
        {
          "expr": "rapid_ai_application_gateway_endpoint_api_calls{ai_application=\"$ai_application\",endpoint_id=~\"$endpoint_id\",outcome=\"failed\"}",
          "legendFormat": "{{endpoint_id}} - failed (400+)"
        },
        {
          "expr": "rapid_ai_application_gateway_endpoint_api_calls{ai_application=\"$ai_application\",endpoint_id=~\"$endpoint_id\",outcome=\"throttled\"}",
          "legendFormat": "{{endpoint_id}} - throttled (429)"
        },
        {
          "expr": "rapid_ai_application_gateway_endpoint_api_calls{ai_application=\"$ai_application\",endpoint_id=~\"$endpoint_id\",outcome=\"filtered\"}",
          "legendFormat": "{{endpoint_id}} - filtered (400)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API calls by endpoint + Application total",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "rapid_ai_application_gateway_endpoint_api_calls{ai_application=\"$ai_application\",endpoint_id=~\"$endpoint_id\",outcome=\"success\"}",
          "legendFormat": "{{endpoint_id}} success"
        },
        {
          "expr": "rapid_ai_application_gateway_endpoint_api_calls{ai_application=\"$ai_application\",endpoint_id=~\"$endpoint_id\",outcome=\"failed\"}",
          "legendFormat": "{{endpoint_id}} failed"
        },
        {
          "expr": "rapid_ai_application_gateway_application_api_calls_overall{ai_application=\"$ai_application\"}",
          "legendFormat": "{{ai_application}} total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* total"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Cache latency (Milliseconds)",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "rapid_ai_application_gateway_application_cache_avg_latency_ms{ai_application=\"$ai_application\"}",
          "legendFormat": "{{cache_tier}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache hit rate % (5m rolling)",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "100 * (sum by (cache_tier) (increase(rapid_ai_application_gateway_application_cache_hits{ai_application=\"$ai_application\"}[5m])) / (sum by (cache_tier) (increase(rapid_ai_application_gateway_application_cache_hits{ai_application=\"$ai_application\"}[5m])) + sum by (cache_tier) (increase(rapid_ai_application_gateway_application_cache_misses{ai_application=\"$ai_application\"}[5m]))))",
          "legendFormat": "{{cache_tier}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Cache average score",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "rapid_ai_application_gateway_application_cache_avg_score{ai_application=\"$ai_application\"}",
          "legendFormat": "{{cache_tier}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens breakdown by endpoint (K)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "rapid_ai_application_gateway_endpoint_input_tokens_thousands{ai_application=\"$ai_application\",endpoint_id=~\"$endpoint_id\"}",
          "legendFormat": "{{endpoint_id}} input"
        },
        {
          "expr": "rapid_ai_application_gateway_endpoint_output_tokens_thousands{ai_application=\"$ai_application\",endpoint_id=~\"$endpoint_id\"}",
          "legendFormat": "{{endpoint_id}} output"
        },
        {
          "expr": "rapid_ai_application_gateway_endpoint_cached_tokens_thousands{ai_application=\"$ai_application\",endpoint_id=~\"$endpoint_id\"}",
          "legendFormat": "{{endpoint_id}} cached"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Total tokens by endpoint (K)",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "rapid_ai_application_gateway_endpoint_tokens_thousands{ai_application=\"$ai_application\"}",
          "legendFormat": "{{endpoint_id}}"
        },
        {
          "expr": "rapid_ai_application_gateway_application_tokens_thousands{ai_application=\"$ai_application\"}",
          "legendFormat": "{{ai_application}} Total (K)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* total"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Token cost breakdown by endpoint",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "rapid_ai_application_gateway_endpoint_input_token_cost_usd{ai_application=\"$ai_application\",endpoint_id=~\"$endpoint_id\"}",
          "legendFormat": "{{endpoint_id}} input"
        },
        {
          "expr": "rapid_ai_application_gateway_endpoint_output_token_cost_usd{ai_application=\"$ai_application\",endpoint_id=~\"$endpoint_id\"}",
          "legendFormat": "{{endpoint_id}} output"
        },
        {
          "expr": "rapid_ai_application_gateway_endpoint_cached_token_cost_usd{ai_application=\"$ai_application\",endpoint_id=~\"$endpoint_id\"}",
          "legendFormat": "{{endpoint_id}} cached"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Total token cost by endpoint",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "rapid_ai_application_gateway_endpoint_token_cost_usd{ai_application=\"$ai_application\"}",
          "legendFormat": "{{endpoint_id}}"
        },
        {
          "expr": "rapid_ai_application_gateway_application_token_cost_usd{ai_application=\"$ai_application\"}",
          "legendFormat": "{{ai_application}} total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}